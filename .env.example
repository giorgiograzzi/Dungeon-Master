# Token del bot Telegram, ottenuto da @BotFather (obbligatorio per far girare il bot)
BOT_TOKEN=

# Chiave API Anthropic per il narratore AI, da console.anthropic.com (obbligatoria dalla Fase 3 in poi)
ANTHROPIC_API_KEY=

# URL di connessione al database: SQLite in locale (default sotto), Postgres (Neon) in produzione.
# Esempio produzione: postgresql+asyncpg://utente:password@host/nome_db
DATABASE_URL=sqlite+aiosqlite:///./dungeon_master.db

# URL pubblico dell'app (es. https://tuo-progetto.onrender.com). Usato per il pulsante Web App
# del bot e come base per il webhook Telegram (<WEBAPP_URL>/telegram/webhook)
WEBAPP_URL=

# Segreto condiviso con Telegram per verificare che le chiamate a /telegram/webhook arrivino
# davvero da Telegram (stringa a piacere, es. generata con `openssl rand -hex 24`)
WEBHOOK_SECRET=

# (opzionale) Lista di ID Telegram autorizzati a usare il bot, separati da virgola.
# Vuoto = tutti ammessi. Esempio: 111111111,222222222
ALLOWED_USER_IDS=

# (opzionale) Numero massimo di turni AI al giorno per utente (protezione costi)
DAILY_TURN_CAP=50

# (opzionale) Modello Anthropic usato per i turni normali e i riassunti di sessione
MODEL_NARRATOR=claude-haiku-4-5-20251001

# (opzionale) Modello Anthropic usato per piano di campagna, colpi di scena, finale ed export
MODEL_CLIMAX=claude-sonnet-5

# (opzionale) Costo del cambio arma in combattimento: "action" (default) oppure "free_interaction"
RULE_WEAPON_SWAP_COST=action

# (opzionale) Porta su cui gira il server in locale/Docker (Render la imposta da sé)
PORT=8000

# (opzionale) A "true"/"1", il narratore usa risposte finte invece di chiamare
# l'API Anthropic: utile per sviluppare/testare senza consumare credito
DEV_FAKE_AI=false
